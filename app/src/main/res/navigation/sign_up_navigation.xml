<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sign_up_navigation"
    app:startDestination="@id/signUpFragment1">

    <fragment
        android:id="@+id/signUpFragment1"
        android:name="com.racks.mydoctor.fragments.SignUpFragment1"
        android:label="SignUpFragment1"
        tools:layout="@layout/fragment_sign_up1">
        <action
            android:id="@+id/action_signUpFragment1_to_signUpFragment2"
            app:destination="@id/signUpFragment2"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
        <action
            android:id="@+id/action_signUpFragment1_to_signUpFragment4"
            app:destination="@id/signUpFragment4" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment2"
        android:name="com.racks.mydoctor.fragments.SignUpFragment2"
        android:label="fragment_sign_up2"
        tools:layout="@layout/fragment_sign_up2" >
        <action
            android:id="@+id/action_signUpFragment2_to_signUpFragment3"
            app:destination="@id/signUpFragment3"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"
            />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment3"
        android:name="com.racks.mydoctor.fragments.SignUpFragment3"
        android:label="fragment_sign_up3"
        tools:layout="@layout/fragment_sign_up3"
        >
        <action
            android:id="@+id/action_signUpFragment3_to_signUpFragment4"
            app:destination="@id/signUpFragment4"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"/>
    </fragment>
    <fragment
        android:id="@+id/signUpFragment4"
        android:name="com.racks.mydoctor.fragments.SignUpFragment4"
        android:label="fragment_sign_up4"
        tools:layout="@layout/fragment_sign_up4" />
</navigation>