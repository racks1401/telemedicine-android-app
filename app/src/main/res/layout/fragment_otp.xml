<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".common.fragments.LoginFragment">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true"
        android:contentDescription="TODO"
        android:foreground="#72000000"
        android:scaleType="centerCrop"
        android:src="@drawable/slide1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_15sdp"
            android:gravity="center"
            android:text=""
            android:textColor="#E6FFFFFF"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/ll_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_30sdp"
            android:layout_marginEnd="@dimen/_30sdp"
            android:layout_marginBottom="@dimen/_5sdp">

            <EditText
                android:id="@+id/et_otp1"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginEnd="2dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/et_otp_bg"
                android:cursorVisible="false"
                android:inputType="number"
                android:maxLength="1" />

            <EditText
                android:id="@+id/et_otp2"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:textColor="@color/white"
                android:gravity="center"
                android:background="@drawable/et_otp_bg"
                android:cursorVisible="false"
                android:inputType="number"
                android:maxLength="1" />

            <EditText
                android:id="@+id/et_otp3"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:background="@drawable/et_otp_bg"
                android:textColor="@color/white"
                android:gravity="center"
                android:cursorVisible="false"
                android:inputType="number"
                android:maxLength="1" />

            <EditText
                android:id="@+id/et_otp4"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:background="@drawable/et_otp_bg"
                android:textColor="@color/white"
                android:gravity="center"
                android:cursorVisible="false"
                android:inputType="number"
                android:maxLength="1" />

            <EditText
                android:id="@+id/et_otp5"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:background="@drawable/et_otp_bg"
                android:textColor="@color/white"
                android:gravity="center"
                android:cursorVisible="false"
                android:inputType="number"
                android:maxLength="1" />

            <EditText
                android:id="@+id/et_otp6"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_marginStart="@dimen/_2sdp"
                android:background="@drawable/et_otp_bg"
                android:textColor="@color/white"
                android:gravity="center"
                android:cursorVisible="false"
                android:inputType="number"
                android:maxLength="1" />

        </LinearLayout>

        <TextView
            android:id="@+id/tv_resend_timeout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#E8E8E8"
            android:textStyle="bold"
            android:padding="5dp"
            android:textSize="@dimen/_11ssp"
            android:layout_marginBottom="@dimen/_15sdp"
            android:text=""/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/verify_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_30sdp"
            android:text="Verify" />

    </LinearLayout>

</RelativeLayout>