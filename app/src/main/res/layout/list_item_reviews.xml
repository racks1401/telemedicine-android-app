<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chooseDate_section"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_5sdp"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:padding="@dimen/_5sdp">

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_reviewer_profile_pic"
        android:layout_width="@dimen/_50sdp"
        android:layout_height="match_parent"
        android:src="@drawable/profile_placeholder" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_5sdp">

        <TextView
            android:id="@+id/tv_reviewer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_marginBottom="@dimen/_5sdp"
            android:text="Reviewr Name"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tv_reviewer_message"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="start"
            android:text="Message sdjkhlsdhjk kjhdsjds jhdskhkd sjdj hjjdshdsj jhdsjdsjdjs hsdjhsdjds kjhksdhjds jdjsh"
            android:textSize="@dimen/_11ssp" />

    </LinearLayout>

</LinearLayout>